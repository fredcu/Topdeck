<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Weather: the approximate location, once, to look up where you are. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Capturing system audio for the Sound tab's per-app volumes (Core Audio process tap). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Music and Spotify's AppleScript, for the media tab's shuffle, repeat, up next, and lyrics.
	     macOS asks once per app (Privacy & Security › Automation). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Weather: WeatherKit is a restricted entitlement. macOS kills an app that claims it without an
	     embedded provisioning profile, so only scripts/sign-weather.sh signs with this file. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>GAFSTKL3RH.net.icuai.topdeck</string>
	<key>com.apple.developer.team-identifier</key>
	<string>GAFSTKL3RH</string>
</dict>
</plist>
